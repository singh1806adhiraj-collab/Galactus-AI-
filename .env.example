# Galactus AI Environment Variables
# Copy this file to .env and fill in your values

# JWT Secret for authentication tokens (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=your_jwt_secret_here

# Encryption key for API keys (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ENCRYPTION_KEY=your_encryption_key_here

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# Backend port
PORT=3001

# Environment
NODE_ENV=development